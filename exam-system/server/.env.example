# Copy this file to .env and fill in real values.  .env is git-ignored — never commit it.

NODE_ENV=development
PORT=4000
TZ=Asia/Kolkata

# --- E2E DBaaS PostgreSQL ---
# Get HOST / USER / PASSWORD from the E2E MyAccount console after creating the DBaaS cluster.
# Keep sslmode=require — E2E DBaaS expects encrypted connections.
DATABASE_URL=postgresql://examuser:CHANGE_ME@YOUR_DBAAS_HOST:5432/sop_exams?sslmode=require

# --- Email ---
# LOCKED rule: the sender is swappable in ONE line — edit EMAIL_FROM only.
EMAIL_FROM=info@morepenpdr.com
EMAIL_FROM_NAME=Morepen SOP Compliance

# SendGrid SMTP (default). For Amazon SES instead, change these four lines only:
#   SMTP_HOST=email-smtp.ap-south-1.amazonaws.com, SMTP_USER/PASS = SES SMTP credentials.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.your-sendgrid-api-key-here

# --- Business constants (defaults match the LOCKED rules; change only with QA approval) ---
PASS_MARK_PERCENT=70
EXAM_DURATION_MINUTES=30
QUESTIONS_PER_EXAM=5
QUESTIONS_PER_DEPT_BANK=50
RETEST_OFFSET_DAYS=7
